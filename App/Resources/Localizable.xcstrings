{
  "sourceLanguage": "en",
  "strings": {
    "%@": {
      "shouldTranslate": false
    },
    "%@ · not on this Mac yet": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · pas encore sur ce Mac"
          }
        }
      }
    },
    "A change is waiting for your decision": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un changement attend ta décision"
          }
        }
      }
    },
    "A critical change is waiting": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un changement critique attend ta décision"
          }
        }
      }
    },
    "Accept": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepter"
          }
        }
      }
    },
    "Accepted": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepté"
          }
        }
      }
    },
    "Add File…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un fichier…"
          }
        }
      }
    },
    "All files match their reference": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les fichiers sont conformes à leur référence"
          }
        }
      }
    },
    "Apple Intelligence is not available on this Mac. Warden uses its built-in rules.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence n'est pas disponible sur ce Mac. Warden utilise ses règles intégrées."
          }
        }
      }
    },
    "Approve Warden in System Settings, under Login Items.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise Warden dans Réglages Système, section Ouverture."
          }
        }
      }
    },
    "Back to reference": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenu à la référence"
          }
        }
      }
    },
