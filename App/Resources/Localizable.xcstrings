        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "IA sur l'appareil"
          }
        }
      }
    },
    "Only security-related keys of this file trigger alerts. Routine writes stay silent.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les clés liées à la sécurité de ce fichier déclenchent une alerte. Les écritures de routine restent silencieuses."
          }
        }
      }
    },
