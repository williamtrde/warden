    },
    "Revert restores the reference and saves a backup.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler restaure la référence et garde une sauvegarde."
          }
        }
      }
    },
    "Revert restores the security keys and saves a backup.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler restaure les clés de sécurité et garde une sauvegarde."
          }
        }
      }
    },
    "Reverted": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulé"
          }
        }
      }
    },
    "Runs on this Mac. Turn it off to use built-in rules only.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle tourne sur ce Mac. Désactive-la pour n'utiliser que les règles intégrées."
          }
        }
      }
    },
    "Select a file": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un fichier"
          }
        }
      }
