      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages de Warden"
          }
        }
      }
    },
    "Warden could not finish this action": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Warden n'a pas pu terminer cette action"
          }
        }
      }
    },
    "Warden is not monitoring your files": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Warden ne surveille pas tes fichiers"
          }
        }
      }
    },
    "Warden is watching %lld files.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Warden is watching %lld file."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Warden is watching %lld files."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Warden surveille %lld fichier."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Warden surveille %lld fichiers."
                }
              }
            }
          }
        }
      }
    },
    "Warden rebuilt its references from its history. Review any change it reports.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Warden a reconstruit ses références depuis son historique. Examine les changements qu'il signale."
          }
        }
      }
    },
    "Warden's records were damaged and rebuilt": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de Warden étaient abîmées et ont été reconstruites"
          }
        }
      }
    },
    "Warden's stored copy of this version is missing or damaged. The file was left untouched.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie de cette version gardée par Warden est absente ou abîmée. Le fichier n'a pas été modifié."
          }
        }
      }
    },
    "Watched files": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers surveillés"
          }
        }
      }
    },
