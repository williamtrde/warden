      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce changement n'attend plus de décision."
          }
        }
      }
    },
    "This file does not exist yet. Warden will alert you if it appears.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n'existe pas encore. Warden t'alertera s'il apparaît."
          }
        }
      }
    },
    "This file is no longer watched.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n'est plus surveillé."
          }
        }
      }
    },
    "Use on-device AI for explanations": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser l'IA sur l'appareil pour les explications"
