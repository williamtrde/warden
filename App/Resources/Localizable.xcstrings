      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que Warden recommande"
          }
        }
      }
    },
    "What changed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui a changé"
          }
        }
      }
